[Unit]
Description=Omarchy workspace title overlay
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so
ExecStart=/usr/bin/python3 %h/.local/bin/omarchy-workspace-osd
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
