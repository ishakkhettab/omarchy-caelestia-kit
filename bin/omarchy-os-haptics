#!/usr/bin/env python3
"""Play configurable UI sounds on Hyprland events. Config: ~/.config/omarchy-haptics/config.json"""
from __future__ import annotations

import json
import os
import socket
import subprocess
import time
from pathlib import Path

HOME = Path.home()
CFG_PATH = HOME / ".config/omarchy-haptics/config.json"
LIB = HOME / ".local/share/omarchy-haptics/library"
PID = HOME / ".local/share/omarchy-haptics/haptics.pid"
DEFAULTS = {
    "enabled": True,
    "master_volume": 0.34,
    "events": {
        "window_open": {"enabled": True, "file": "click3.wav", "volume": 1.0},
        "window_close": {"enabled": True, "file": "click2.wav", "volume": 1.0},
        "workspace": {"enabled": True, "file": "switch7.wav", "volume": 1.0},
        "window_switch": {"enabled": True, "file": "switch27.wav", "volume": 0.9},
        "fullscreen": {"enabled": True, "file": "switch25.wav", "volume": 1.0},
        "float": {"enabled": True, "file": "click1.wav", "volume": 0.75},
    },
}

cfg: dict = {}
cfg_mtime = 0.0
last_workspace = 0.0
last_focus = 0.0
last_focus_addr = ""


def load_cfg(force: bool = False) -> None:
    global cfg, cfg_mtime
    try:
        mtime = CFG_PATH.stat().st_mtime
    except FileNotFoundError:
        cfg = json.loads(json.dumps(DEFAULTS))
        cfg_mtime = 0.0
        return
    if not force and mtime == cfg_mtime:
        return
    cfg_mtime = mtime
    data = json.loads(CFG_PATH.read_text())
    merged = json.loads(json.dumps(DEFAULTS))
    merged["enabled"] = bool(data.get("enabled", True))
    merged["master_volume"] = float(data.get("master_volume", 0.34))
    events = data.get("events") or {}
    for key, default in DEFAULTS["events"].items():
        src = events.get(key) or {}
        merged["events"][key] = {
            "enabled": bool(src.get("enabled", default["enabled"])),
            "file": str(src.get("file", default["file"])),
            "volume": float(src.get("volume", default["volume"])),
        }
    cfg = merged


def resolve_sound(name: str) -> Path | None:
    if not name:
        return None
    p = Path(name).expanduser()
    if p.is_absolute() and p.is_file():
        return p
    for base in (LIB, HOME / ".local/share/omarchy-haptics"):
        cand = base / name
        if cand.is_file():
            return cand
    return None


def play_event(key: str) -> None:
    load_cfg()
    if not cfg.get("enabled"):
        return
    ev = (cfg.get("events") or {}).get(key) or {}
    if not ev.get("enabled"):
        return
    path = resolve_sound(str(ev.get("file", "")))
    if path is None:
        return
    vol = max(0.0, min(1.0, float(cfg.get("master_volume", 0.34)) * float(ev.get("volume", 1.0))))
    if vol <= 0.001:
        return
    subprocess.Popen(
        ["pw-play", f"--volume={vol:.3f}", str(path)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def hypr_socket() -> Path:
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    if sig:
        p = runtime / "hypr" / sig / ".socket2.sock"
        if p.exists():
            return p
    socks = sorted((runtime / "hypr").glob("*/.socket2.sock"), key=lambda x: x.stat().st_mtime, reverse=True)
    if not socks:
        raise SystemExit("no hyprland socket")
    return socks[0]


def listen() -> None:
    PID.parent.mkdir(parents=True, exist_ok=True)
    PID.write_text(str(os.getpid()))
    load_cfg(force=True)
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(str(hypr_socket()))
    buf = b""
    global last_workspace, last_focus, last_focus_addr
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            raw = line.decode("utf-8", "replace")
            event, _, payload = raw.partition(">>")
            now = time.monotonic()
            if event == "openwindow":
                play_event("window_open")
            elif event == "closewindow":
                play_event("window_close")
            elif event in ("workspace", "workspacev2"):
                last_workspace = now
                play_event("workspace")
            elif event in ("activewindow", "activewindowv2"):
                addr = payload.strip()
                if not addr or addr == last_focus_addr:
                    continue
                if now - last_workspace < 0.18:
                    last_focus_addr = addr
                    continue
                if now - last_focus < 0.11:
                    continue
                last_focus = now
                last_focus_addr = addr
                play_event("window_switch")
            elif event == "fullscreen":
                play_event("fullscreen")
            elif event == "changefloatingmode":
                play_event("float")


if __name__ == "__main__":
    listen()
