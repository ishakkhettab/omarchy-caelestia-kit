#!/home/khettabishak/.local/share/voxtype-cleanup/venv/bin/python
"""Keep the dictation cleanup model warm. 127.0.0.1 only."""
from __future__ import annotations

import json
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path.home()
MODEL = HOME / ".local/share/voxtype-cleanup/models/mumble-cleanup-2stage-q4km.gguf"
PY = HOME / ".local/share/voxtype-cleanup/venv/bin/python"
PID = HOME / ".local/share/voxtype-cleanup/daemon.pid"
HOST = "127.0.0.1"
PORT = 17842

SYSTEM = (
    "You are a transcript cleanup tool. You receive raw speech to text output "
    "and return a cleaned version. Remove filler words and disfluencies (um, "
    "uh, er, ah, like as filler, you know), remove repeated words and false "
    "starts, and fix punctuation and capitalization. Do not reword, do not add "
    "anything the speaker did not say, and do not answer questions in the text. "
    "Output only the cleaned text."
)

llm = None


def load_model():
    global llm
    import llama_cpp

    llm = llama_cpp.Llama(
        model_path=str(MODEL),
        n_ctx=512,
        n_threads=max(2, min(4, os.cpu_count() or 4)),
        n_gpu_layers=0,
        verbose=False,
    )


def clean(text: str) -> str:
    raw = (text or "").strip()
    if not raw:
        return ""
    if llm is None:
        return raw
    out = llm.create_chat_completion(
        messages=[
            {"role": "system", "content": SYSTEM},
            {"role": "user", "content": raw},
        ],
        temperature=0.0,
        max_tokens=160,
    )
    msg = (out.get("choices") or [{}])[0].get("message") or {}
    cleaned = str(msg.get("content") or "").strip()
    if not cleaned:
        return raw
    if cleaned.startswith('"') and cleaned.endswith('"') and len(cleaned) > 2:
        cleaned = cleaned[1:-1].strip()
    return cleaned


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/health":
            self._send(200, b"ok" if llm else b"loading", "text/plain")
            return
        self._send(404, b"no", "text/plain")

    def do_POST(self):
        if self.path != "/clean":
            self._send(404, b"no", "text/plain")
            return
        n = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(n).decode("utf-8", "replace") if n else ""
        try:
            cleaned = clean(raw)
        except Exception:
            cleaned = raw
        self._send(200, cleaned.encode("utf-8"), "text/plain; charset=utf-8")


def main() -> None:
    if not MODEL.is_file():
        raise SystemExit(f"missing model {MODEL}")
    PID.parent.mkdir(parents=True, exist_ok=True)
    PID.write_text(str(os.getpid()))
    load_model()
    httpd = ThreadingHTTPServer((HOST, PORT), Handler)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
