#!/usr/bin/env bash
# Follow Omarchy theme wallpaper changes so Caelestia shows the same image.
set -euo pipefail
LINK_DIR="${HOME}/.local/state/omarchy/current"
PATH_FILE="${HOME}/.local/state/caelestia/wallpaper/path.txt"

sync_now() {
  local src
  src=$(readlink -f "${LINK_DIR}/background" 2>/dev/null || true)
  [[ -n $src && -f $src ]] || return 0
  mkdir -p "$(dirname "$PATH_FILE")"
  printf '%s\n' "$src" >"$PATH_FILE"
  "${HOME}/.local/bin/omarchy-sync-caelestia" >/dev/null 2>&1 || true
  pw-play --volume=0.85 /home/khettabishak/.local/share/omarchy-haptics/library/switch34.wav 2>/dev/null || true
}

sync_now
while inotifywait -q -e create,modify,move,attrib,delete "$LINK_DIR" "$LINK_DIR/background" 2>/dev/null; do
  sync_now
done
