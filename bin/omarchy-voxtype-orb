#!/usr/bin/python3
"""Switch Voxtype dictation orb styles."""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

HOME = Path.home()
OSD = HOME / ".config/voxtype/osd"
BIN = "/usr/lib/voxtype/voxtype-onnx-avx2"

STYLES = {
    "dictator": OSD / "voice-dictator",
    "jarvis": OSD / "voxuirestyle",
    "omarchy": OSD / "voxtype-osd-omarchy",
}


def run(args: list[str]) -> str:
    return subprocess.check_output(args, text=True).strip()


def current() -> str:
    try:
        path = run([BIN, "config", "get", "osd.style"])
    except subprocess.CalledProcessError:
        return ""
    for name, dest in STYLES.items():
        if path.rstrip("/") == str(dest):
            return name
    return path


def set_style(name: str) -> None:
    if name not in STYLES:
        raise SystemExit(f"unknown style {name}. choose: {', '.join(STYLES)}")
    path = STYLES[name]
    subprocess.check_call([BIN, "config", "set", "osd.style", str(path)])
    subprocess.check_call([BIN, "config", "set", "osd.palette", "omarchy"])
    subprocess.check_call([BIN, "config", "set", "osd.layout", "custom"])
    subprocess.check_call([BIN, "config", "set", "osd.frontend", "quickshell"])
    if name == "dictator":
        subprocess.check_call([BIN, "config", "set", "osd.width_px", "280"])
        subprocess.check_call([BIN, "config", "set", "osd.height_px", "280"])
    elif name == "jarvis":
        subprocess.check_call([BIN, "config", "set", "osd.width_px", "240"])
        subprocess.check_call([BIN, "config", "set", "osd.height_px", "240"])
    else:
        subprocess.check_call([BIN, "config", "set", "osd.width_px", "400"])
        subprocess.check_call([BIN, "config", "set", "osd.height_px", "48"])
    subprocess.check_call(["systemctl", "--user", "restart", "voxtype"])
    print(f"orb style = {name}")


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("list", "--list"):
        cur = current()
        for name in STYLES:
            mark = "*" if name == cur else " "
            print(f"{mark} {name}  {STYLES[name]}")
        return 0
    if args[0] == "get":
        print(current() or "unknown")
        return 0
    if args[0] == "set" and len(args) > 1:
        set_style(args[1])
        return 0
    if args[0] in STYLES:
        set_style(args[0])
        return 0
    print("usage: omarchy-voxtype-orb list|get|set <dictator|jarvis|omarchy>")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
