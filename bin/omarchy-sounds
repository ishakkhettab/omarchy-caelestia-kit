#!/usr/bin/env python3
"""Local System Sounds settings app. Binds 127.0.0.1 only."""
from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote, urlparse

HOME = Path.home()
HOST = "127.0.0.1"
PORT = 17841
APP = HOME / ".local/share/omarchy-sounds/app/index.html"
CFG = HOME / ".config/omarchy-haptics/config.json"
LIB = HOME / ".local/share/omarchy-haptics/library"
LOCK = HOME / ".local/share/omarchy-sounds/server.port"

DEFAULTS = {
    "enabled": True,
    "master_volume": 0.34,
    "events": {
        "window_open": {"enabled": True, "file": "click3.wav", "volume": 1.0},
        "window_close": {"enabled": True, "file": "click2.wav", "volume": 1.0},
        "workspace": {"enabled": True, "file": "switch7.wav", "volume": 1.0},
        "window_switch": {"enabled": True, "file": "switch27.wav", "volume": 0.9},
        "fullscreen": {"enabled": True, "file": "switch25.wav", "volume": 1.0},
        "float": {"enabled": True, "file": "click1.wav", "volume": 0.75},
    },
}


def load_cfg() -> dict:
    if CFG.is_file():
        data = json.loads(CFG.read_text())
    else:
        data = {}
    merged = json.loads(json.dumps(DEFAULTS))
    merged["enabled"] = bool(data.get("enabled", True))
    merged["master_volume"] = float(data.get("master_volume", 0.34))
    events = data.get("events") or {}
    for key, default in DEFAULTS["events"].items():
        src = events.get(key) or {}
        merged["events"][key] = {
            "enabled": bool(src.get("enabled", default["enabled"])),
            "file": str(src.get("file", default["file"])),
            "volume": float(src.get("volume", default["volume"])),
        }
    return merged


def save_cfg(data: dict) -> None:
    CFG.parent.mkdir(parents=True, exist_ok=True)
    CFG.write_text(json.dumps(load_merged(data), indent=2) + "\n")
    sync = HOME / ".local/bin/omarchy-kit-sync"
    if sync.is_file():
        subprocess.Popen([str(sync), "--quiet"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_merged(data: dict) -> dict:
    merged = json.loads(json.dumps(DEFAULTS))
    merged["enabled"] = bool(data.get("enabled", merged["enabled"]))
    merged["master_volume"] = float(data.get("master_volume", merged["master_volume"]))
    events = data.get("events") or {}
    for key, default in DEFAULTS["events"].items():
        src = events.get(key) or {}
        merged["events"][key] = {
            "enabled": bool(src.get("enabled", default["enabled"])),
            "file": str(src.get("file", default["file"])),
            "volume": float(src.get("volume", default["volume"])),
        }
    return merged


def library_files() -> list[str]:
    if not LIB.is_dir():
        return []
    return sorted(p.name for p in LIB.glob("*.wav"))


def resolve_sound(name: str) -> Path | None:
    if not name:
        return None
    p = Path(name).expanduser()
    if p.is_absolute() and p.is_file():
        return p
    cand = LIB / Path(name).name
    return cand if cand.is_file() else None


def play(path: Path, volume: float) -> None:
    vol = max(0.0, min(1.0, volume))
    subprocess.Popen(
        ["pw-play", f"--volume={vol:.3f}", str(path)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, code: int, obj) -> None:
        self._send(code, json.dumps(obj).encode(), "application/json")

    def do_GET(self) -> None:
        path = urlparse(self.path).path
        if path in ("/", "/index.html"):
            self._send(200, APP.read_bytes(), "text/html; charset=utf-8")
            return
        if path == "/api/config":
            self._json(200, load_cfg())
            return
        if path == "/api/library":
            self._json(200, {"files": library_files()})
            return
        if path.startswith("/library/"):
            name = unquote(path.split("/", 2)[-1])
            sound = resolve_sound(name)
            if sound is None:
                self._send(404, b"missing", "text/plain")
                return
            self._send(200, sound.read_bytes(), "audio/wav")
            return
        self._send(404, b"not found", "text/plain")

    def do_POST(self) -> None:
        length = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(length) if length else b"{}"
        try:
            data = json.loads(raw.decode() or "{}")
        except json.JSONDecodeError:
            self._json(400, {"error": "bad json"})
            return
        path = urlparse(self.path).path
        if path == "/api/config":
            save_cfg(data)
            self._json(200, {"ok": True})
            return
        if path == "/api/play":
            cfg = load_cfg()
            if data.get("event"):
                ev = cfg["events"].get(data["event"]) or {}
                sound = resolve_sound(str(ev.get("file", "")))
                vol = float(cfg.get("master_volume", 0.34)) * float(ev.get("volume", 1))
            else:
                sound = resolve_sound(str(data.get("file", "")))
                vol = float(cfg.get("master_volume", 0.34))
            if sound is None:
                self._json(404, {"error": "missing sound"})
                return
            play(sound, vol)
            self._json(200, {"ok": True})
            return
        self._json(404, {"error": "not found"})


def port_open() -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.3)
        return s.connect_ex((HOST, PORT)) == 0


def main() -> None:
    url = f"http://{HOST}:{PORT}/"
    if port_open():
        webbrowser.open(url)
        return
    httpd = ThreadingHTTPServer((HOST, PORT), Handler)
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    LOCK.write_text(str(PORT))
    webbrowser.open(url)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()


if __name__ == "__main__":
    sys.exit(main() or 0)
