#!/usr/bin/env python3
"""Cycle focused window opacity: 100% → 90% → 80% → 70% → 100%.
Keeps the level on fullscreen via alphaoverride + alphafullscreen."""
from __future__ import annotations

import json
import subprocess

LEVELS = [1.0, 0.9, 0.8, 0.7]


def hypr_json(args: list[str]):
    return json.loads(subprocess.check_output(["hyprctl", "-j", *args], text=True))


def dispatch(expr: str) -> None:
    subprocess.run(
        ["hyprctl", "dispatch", expr],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def setprop(addr: str, prop: str, value: str) -> None:
    dispatch(
        "hl.dsp.window.set_prop({ window = %s, prop = %s, value = %s })"
        % (json.dumps("address:" + addr), json.dumps(prop), json.dumps(value))
    )
    dispatch(f"setprop address:{addr} {prop} {value}")


def nearest_index(alpha: float) -> int:
    return min(range(len(LEVELS)), key=lambda i: abs(LEVELS[i] - alpha))


def current_alpha(win: dict) -> float:
    for key in ("alpha", "opacity"):
        if key in win and win[key] is not None:
            try:
                return float(win[key])
            except (TypeError, ValueError):
                pass
    return 1.0


def main() -> None:
    win = hypr_json(["activewindow"])
    addr = win.get("address")
    if not addr:
        return
    nxt = (nearest_index(current_alpha(win)) + 1) % len(LEVELS)
    alpha = LEVELS[nxt]
    val = f"{alpha:.2f}"
    setprop(addr, "opaque", "0")
    setprop(addr, "alphaoverride", "1")
    setprop(addr, "alpha", val)
    setprop(addr, "alphafullscreen", val)
    setprop(addr, "alpha_fullscreen", val)


if __name__ == "__main__":
    main()
